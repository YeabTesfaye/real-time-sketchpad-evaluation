{
  "name": "real-time-sketchpad",
  "version": "0.1.0",
  "private": true,
  "description": "A real-time collaborative sketchpad built with Next.js and FastAPI",
  "scripts": {
    "dev": "concurrently \"npm run dev -w frontend\" \"uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000\"",
    "dev:frontend": "npm run dev -w frontend",
    "dev:backend": "uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm run build -w frontend",
    "start": "npm run start -w frontend",
    "lint": "npm run lint -w frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}