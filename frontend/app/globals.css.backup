@import "tailwindcss";
@custom-variant dark (&:is(.dark *));

:root {
  --background: #F6F3EC;
  --foreground: #16140F;
  --card: #FBF9F4;
  --card-foreground: #16140F;
  --popover: #FBF9F4;
  --popover-foreground: #16140F;
  --primary: #D63B1F;
  --primary-foreground: #FFFFFF;
  --secondary: #ECE7DB;
  --secondary-foreground: #16140F;
  --muted: #ECE7DB;
  --muted-foreground: #6B665B;
  --accent: #D63B1F;
  --accent-foreground: #FFFFFF;
  --destructive: #E5472B;
  --destructive-foreground: #FFFFFF;
  --border: #DDD7C8;
  --input: #DDD7C8;
  --ring: #D63B1F;
  --radius: 0.375rem;
  --card-radius: 0.625rem;
}

.dark {
  --background: #14130F;
  --foreground: #F1EDE2;
  --card: #1C1B16;
  --card-foreground: #F1EDE2;
  --popover: #1C1B16;
  --popover-foreground: #F1EDE2;
  --primary: #FF6A4D;
  --primary-foreground: #14130F;
  --secondary: #2B2920;
  --secondary-foreground: #F1EDE2;
  --muted: #26241D;
  --muted-foreground: #A8A294;
  --accent: #FF6A4D;
  --accent-foreground: #14130F;
  --destructive: #FF6A4D;
  --destructive-foreground: #14130F;
  --border: #2B2920;
  --input: #2B2920;
  --ring: #FF6A4D;
  --card-radius: 0.625rem;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --radius: var(--radius);
  --card-radius: var(--card-radius);
  --font-display: var(--font-display);
  --font-sans: var(--font-sans);
  --font-mono: var(--font-mono);
  --font-serif: var(--font-display);
}